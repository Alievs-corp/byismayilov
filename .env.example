# Copy to .env and fill in. Never commit .env.
# Public variables (NEXT_PUBLIC_*) are inlined into the browser bundle at build time.

# Public origin of the site, no trailing slash. Used for canonical URLs, hreflang and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3030

# PostgreSQL connection string. docker-compose.yml starts a matching local database.
DATABASE_URL=postgres://byismayilov:change-me@localhost:5462/byismayilov
# Host port docker-compose publishes Postgres on; change it (and DATABASE_URL) if 5462 is taken.
POSTGRES_PORT=5462
# Local database password; docker-compose.yml creates the database with it. Keep it equal to the one in DATABASE_URL.
POSTGRES_PASSWORD=change-me

# S3-compatible object storage for media (Hetzner Object Storage in production, RustFS from docker-compose.yml locally).
# The app streams objects through /media/<key>, so the bucket does not need to be public.
S3_ENDPOINT=http://localhost:9030
S3_REGION=eu-central
S3_BUCKET=byismayilov
S3_ACCESS_KEY_ID=byismayilov
S3_SECRET_ACCESS_KEY=change-me

# Better Auth: a random string of at least 32 characters (openssl rand -base64 32) and the app origin.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3030

# Outgoing mail for booking request notifications. Locally, Mailpit from docker-compose.yml
# catches everything (web UI on http://localhost:8055).
SMTP_HOST=localhost
SMTP_PORT=1055
SMTP_USER=byismayilov
SMTP_PASSWORD=change-me
SMTP_FROM="byismayilov <no-reply@example.com>"
# Inbox that receives new booking requests when the admin settings name none.
BOOKING_NOTIFY_EMAIL=salon@example.com
